{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@core/*": ["core/*"],
      "@ui/*": ["ui/*"],
      "@storage/*": ["storage/*"],
      "@security/*": ["security/*"]
    }
  }
}
